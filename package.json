{
  "name": "whimsicality-mcp",
  "version": "0.1.1",
  "description": "MCP server giving AI agents persistent memory, RAG search, facts, plans, and snippet storage. Works with any MCP-compatible agent (Devin CLI, Claude Desktop, etc.). Optional Rust kernel backend for tiered storage.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "bin": {
    "whimsicality-mcp": "bin/whimsicality-mcp.js"
  },
  "files": [
    "lib",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node bin/whimsicality-mcp.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai",
    "agent",
    "memory",
    "persistent",
    "rag",
    "kernel",
    "rust",
    "claude",
    "devin"
  ],
  "license": "MIT",
  "author": "WhimsicalityLabs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WhimsicalityLabs/Whimsicality-MCP.git"
  },
  "homepage": "https://github.com/WhimsicalityLabs/Whimsicality-MCP",
  "bugs": {
    "url": "https://github.com/WhimsicalityLabs/Whimsicality-MCP/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0"
  },
  "optionalDependencies": {
    "@whimsicalitylabs/kernel-prebuilt": "^0.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0"
  }
}
